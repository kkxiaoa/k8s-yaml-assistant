{
  "name": "k8s-yaml-assistant",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "description": "Evidence-first Kubernetes YAML authoring copilot with schema-backed validation, generation, repair, and evaluation.",
  "scripts": {
    "ask": "tsx src/cli/ask.ts",
    "check": "tsx src/cli/check.ts",
    "gen": "tsx src/cli/gen.ts",
    "eval": "tsx src/eval/retrieval-eval.ts",
    "eval:faith": "tsx src/eval/faithfulness-eval.ts",
    "eval:judge": "tsx src/eval/judge-eval.ts",
    "build:calibration": "tsx scripts/build-calibration.ts",
    "eval:gen": "tsx src/eval/generation-eval.ts",
    "eval:fix": "tsx src/eval/fix-eval.ts",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "eval:promote": "tsx scripts/eval-promote.ts",
    "badcases:faith": "tsx scripts/faith-bad-cases.ts",
    "voyage:ab": "tsx scripts/voyage-ab.ts",
    "aliases:generate": "tsx scripts/generate-schema-aliases.ts",
    "aliases:check": "tsx scripts/check-schema-aliases.ts",
    "aliases:review": "tsx scripts/check-schema-aliases.ts --review",
    "aliases:ab": "tsx scripts/query-expansion-ab.ts",
    "eval:check": "tsx scripts/eval-check.ts",
    "ingest:schemas": "tsx scripts/ingest-schemas.ts",
    "schemas:check": "tsx scripts/check-schemas.ts",
    "corpus:stats": "tsx scripts/corpus-stats.ts",
    "corpus:closure": "tsx scripts/curated-closure.ts",
    "index:build": "tsx scripts/index-build.ts",
    "adapter:check": "pyright --project pyrightconfig.json && python3 -B -m unittest discover -s deploy/adapter -p 'test_*.py'",
    "deploy:check": "node --import tsx --test scripts/deployment-contract.test.ts",
    "release:check": "node --import tsx --test scripts/release-build-contract.test.ts",
    "release:manifest": "tsx scripts/release-manifest.ts",
    "deployment:authorize": "tsx scripts/deployment-authorization.ts",
    "workflow:check": "node --import tsx --test scripts/workflow-contract.test.ts",
    "container:build:runtime-base": "tsx scripts/container-smoke.ts --build-runtime-base --image k8s-yaml-assistant:test-runtime-base",
    "container:smoke:runtime-base": "tsx scripts/container-smoke.ts --expect-index-missing --image k8s-yaml-assistant:test-runtime-base",
    "test": "node --import tsx --test --test-concurrency=1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.1",
    "@monaco-editor/react": "4.7.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "17.4.2",
    "js-yaml": "4.3.0",
    "next": "16.2.12",
    "next-auth": "4.24.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "pyright": "1.1.411",
    "tailwindcss": "^4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
