{
  "name": "k8s-yaml-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "K8s YAML 智能助手:CLI(ask/check/gen)+ 评估(eval)+ Next.js Web(Monaco)。Anthropic SDK 接 DeepSeek + Voyage。",
  "scripts": {
    "ask": "tsx src/cli/ask.ts",
    "check": "tsx src/cli/check.ts",
    "gen": "tsx src/cli/gen.ts",
    "eval": "tsx src/eval/eval.ts",
    "eval:faith": "tsx src/eval/faithfulness.ts",
    "eval:judge": "tsx src/eval/judge-eval.ts",
    "build:calibration": "tsx scripts/build-calibration.ts",
    "eval:gen": "tsx src/eval/generation-eval.ts",
    "eval:fix": "tsx src/eval/fix-eval.ts",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "eval:promote": "tsx scripts/eval-promote.ts",
    "eval:check": "tsx scripts/eval-check.ts",
    "ingest:schemas": "tsx scripts/ingest-schemas.ts",
    "schemas:check": "tsx scripts/check-schemas.ts",
    "corpus:stats": "tsx scripts/corpus-stats.ts",
    "corpus:closure": "tsx scripts/curated-closure.ts",
    "index:build": "tsx scripts/index-build.ts",
    "test": "tsx src/validation/validate.test.ts && tsx src/server/agent.test.ts && tsx src/knowledge/policy-corpus.test.ts && tsx src/retrieval/boost.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@monaco-editor/react": "latest",
    "dotenv": "latest",
    "js-yaml": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/js-yaml": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "^4.3.1",
    "tsx": "latest",
    "typescript": "latest"
  }
}
