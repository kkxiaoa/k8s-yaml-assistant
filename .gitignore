# 依赖
node_modules/

# Next.js 构建产物 / 缓存
.next/
out/
next-env.d.ts

# 其他构建产物
dist/
build/
*.tsbuildinfo
data/schemas/generated/
# 持久化索引:派生自 CORPUS + 嵌入模型,体积大(~33MB f32)。由 index:build / CI 重建,不入 git。
data/index/
data/index-ab/
# 未审核 alias 草稿只用于本地人工审核；正式注册表单独提交。
data/aliases/drafts/
# eval run 与逐 case trace 是可重建的本地证据，不入 Git。
data/eval/runs/
data/eval/traces/
# serving 观测数据不属于 eval artifact，不入 Git。
data/observability/
# 本地体验控制库含额度与备份状态，不入 Git 或镜像。
data/control/

# Python 本地缓存
__pycache__/
*.pyc
.ruff_cache/

# 环境变量(含 API key,绝不提交!).env.example 会被保留
.env
.env.local
.env*.local

# 杂项
.DS_Store
*.log
.cache/

/AGENTS.md
/CLAUDE.md
/HANDOFF.md
/docs/
/scripts/k3s-image-preheat.sh
